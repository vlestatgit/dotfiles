// ---------------- Fast Fetch ---------------- >

// Use "configex.jsonc" for your own config, this one is customized for my own setup

{

  "$schema" : "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo" : {

    "source" : "arch_small",
    "color"  : { "1" : "blue" },

    "padding" : {

      "top"   : 1,
      "left"  : 2,
      "right" : 4

    }

  },

  "display" : {

    "separator" : " ",

    "color" : { "separator" : "white" }

  },

  "modules" : [

    "break",

    // -------- System --------

    {

      "type"     : "title",
      "key"      : "╭─ 󰌢 host   ",
      "keyColor" : "red"

    },

    {

      "type"     : "os",
      "key"      : "│   os     ",
      "keyColor" : "red",
      "format"   : "cachyos 26.08.09 x86_64"

    },

    {

      "type"     : "kernel",
      "key"      : "│   kernel ",
      "keyColor" : "red",
      "format"   : "linux 7.2.8 2 cachyos"

    },

    {

      "type"     : "wm",
      "key"      : "╰─ 󱂬 wm     ",
      "keyColor" : "red",
      "format"   : "hyprland 0.57.0 wayland"

    },

    "break",

    // -------- Hardware --------

    {

      "type"     : "cpu",
      "key"      : "╭─ 󰻠 cpu    ",
      "keyColor" : "cyan",
      "format"   : "intel core i5 12500h"

    },
    
    {

      "type"     : "custom",
      "key"      : "│  󰢮 gpu    ",
      "keyColor" : "blue",
      "format"   : "nvidia geforce rtx 3050 mobile"

    },

    {

      "type"     : "custom",
      "key"      : "│  󰢮 gpu    ",
      "keyColor" : "blue",
      "format"   : "intel iris xe graphics"

    },

    {

      "type"     : "memory",
      "key"      : "│   ram    ",
      "keyColor" : "yellow"

    },

    {

      "type"     : "disk",
      "key"      : "╰─ 󰋊 disk   ",
      "keyColor" : "yellow"

    },

    "break",

    {

      "type"   : "colors",
      "symbol" : "circle"
      
    },

    "break"

  ]
  
}